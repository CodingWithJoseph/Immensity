# ProblemFinderBackend — environment variables
# Copy to `.env` and fill in. Never commit the real `.env`.

# --- App ---
APP_NAME=Immensity API
# Customer-facing product name used in outbound copy (emails, etc.).
PRODUCT_NAME=Immensity
ENVIRONMENT=development
DEBUG=false
# Product surface: "core" exposes the MVP; "full" also exposes deferred features.
# Development defaults to full when omitted. Staging/production must set this explicitly.
FEATURE_PROFILE=full

# --- Database (Supabase / Postgres) ---
# Async driver URL, e.g. postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/problemfinder

# --- Firebase (auth + Firestore) ---
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS_PATH=firebase-service-account-prod.json

# --- Stripe ---
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_PRO_YEARLY_PRICE_ID=price_...
STRIPE_ELITE_MONTHLY_PRICE_ID=price_...
STRIPE_ELITE_YEARLY_PRICE_ID=price_...
# Minutes a Stripe Connect OAuth state token stays valid.
STRIPE_OAUTH_STATE_TTL_MINUTES=15
APP_URL=http://localhost:3000

# --- OpenAI (search embeddings) ---
OPENAI_API_KEY=sk-...

# --- Conversational search interpreter (local development) ---
SEARCH_INTERPRETER_PROVIDER=local
SEARCH_INTERPRETER_BASE_URL=http://127.0.0.1:8080/v1
SEARCH_INTERPRETER_MODEL=gpt-oss-20b
SEARCH_INTERPRETER_TIMEOUT_SECONDS=30
# Railway: use provider=groq, base URL=https://api.groq.com/openai/v1,
# model=openai/gpt-oss-20b, and store GROQ_API_KEY as a Railway secret.
GROQ_API_KEY=

# --- Optional external evidence search (Groq web search) ---
# Off by default. Enable in staging first; the endpoint also requires explicit
# user confirmation and returns citations only (generated prose is discarded).
SEARCH_WEB_ENABLED=false
SEARCH_WEB_MODEL=groq/compound-mini
SEARCH_WEB_TIMEOUT_SECONDS=12

# --- Signal workspace analysis ---
# Blank provider/base URL/model values inherit SEARCH_INTERPRETER_*.
# The API safely leases durable jobs; set worker enabled false on the web
# service only when a separate worker runs:
#   python -m app.workers.signal_analysis
SIGNAL_ANALYSIS_PROVIDER=
SIGNAL_ANALYSIS_BASE_URL=
SIGNAL_ANALYSIS_MODEL=
SIGNAL_ANALYSIS_TIMEOUT_SECONDS=90
SIGNAL_ANALYSIS_MAX_EVIDENCE=30
SIGNAL_ANALYSIS_MIN_EVIDENCE=3
SIGNAL_ANALYSIS_WORKER_ENABLED=true
SIGNAL_ANALYSIS_POLL_SECONDS=2

# --- Anthropic (recommended next step / opportunity briefs) ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Email ---
# Transport: "console" (default; logs the message, no creds needed) or "resend".
EMAIL_TRANSPORT=console
EMAIL_FROM=invites@useimmensity.com
# Only used when EMAIL_TRANSPORT=resend:
RESEND_API_KEY=
# Hours a team invite link stays valid (default 7 days).
INVITE_TOKEN_TTL_HOURS=168

# --- Revenue auto-sync ---
# How often to re-pull connected Stripe revenue sources, in hours (0 disables).
REVENUE_SYNC_INTERVAL_HOURS=6
# Lookback span for new-customer / churn revenue stats, in days.
REVENUE_SYNC_WINDOW_DAYS=30

# --- Analytics windows (days) ---
# Single source of truth for the monitoring readouts; each API response echoes
# the window it used so the frontend renders labels from data.
ANALYTICS_USAGE_WINDOW_DAYS=14
ANALYTICS_CORRELATION_WINDOW_DAYS=30
ANALYTICS_RETENTION_WINDOW_DAYS=30
ANALYTICS_GROWTH_WINDOW_DAYS=7

# --- Alerting ---
# Scheduled checks email the product owner. Real mail only sends when
# EMAIL_TRANSPORT=resend; otherwise the console transport logs it.
ALERTS_ENABLED=true
ALERT_CHECK_INTERVAL_HOURS=1
# Days of history averaged into the error-spike baseline (excludes today).
ALERT_ERROR_BASELINE_DAYS=7
# Signup comparison span: this window vs the immediately prior one.
ALERT_SIGNUPS_WINDOW_DAYS=7
# Max new-issue emails emitted per run (anti-blast cap).
ALERT_NEW_ISSUE_CAP=5

# --- CORS (comma-separated allowlist of frontend origins) ---
ALLOWED_ORIGINS=http://localhost:3000
