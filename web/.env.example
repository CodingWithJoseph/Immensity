# Authenticated /api requests are proxied to ProblemFinderBackend.
# Development defaults to this URL when the variable is omitted.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Product surface: "core" exposes the MVP; "full" also exposes deferred features.
# Local development defaults to full. Staging/production builds must set this explicitly.
NEXT_PUBLIC_FEATURE_PROFILE=full

# Firebase client configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin configuration used by server-side auth verification
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
