# ProblemFinderAI environment variables
# Copy to `.env` and fill in. Never commit the real `.env`.

# --- Local PostgreSQL (continuous-pipeline system of record) ---
LOCAL_DATABASE_URL=postgresql://problemfinder:problemfinder@localhost:5432/problemfinder_local

# --- Supabase (explicit final sync destination only) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- OpenAI (embeddings: text-embedding-3-large, 3072-d) ---
OPENAI_API_KEY=sk-...

# --- GitHub ---
# Public Issues work without a token but are rate-limited more aggressively.
# GitHub Discussions use GraphQL and require this token.
GITHUB_TOKEN=
# Optional: replace the built-in grouped repo registry with comma-separated targets.
# GITHUB_REPOSITORIES=n8n-io/n8n,supabase/supabase,langchain-ai/langchain
# GITHUB_API_URL=https://api.github.com

# --- Stack Exchange ---
# Optional for public question scraping. Add an application key for higher/managed quota.
STACKEXCHANGE_KEY=

# --- Hacker News ---
# Official Firebase API requires no credentials.

# --- Reddit / PRAW (scraper credentials) ---
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
REDDIT_USER_AGENT=problemfinder/0.1 by your-username

# --- Hugging Face (Qwen model download / cache) ---
HF_TOKEN=hf_...
# Optional: override the model/cache directory
# HF_HOME=/path/to/hf-cache

# Scheduling is external; scripts/scheduler.py is the executable schedule.
